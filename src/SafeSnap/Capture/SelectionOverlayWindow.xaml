<Window
    x:Class="SafeSnap.Capture.SelectionOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SafeSnap capture"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    ShowActivated="True"
    Focusable="True"
    WindowStartupLocation="Manual"
    Background="Black"
    Cursor="Cross"
    UseLayoutRounding="True">
    <Grid>
        <Image x:Name="FrozenImage" Stretch="Fill" IsHitTestVisible="False" />
        <Canvas x:Name="Chrome" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#99000000" />
            <Rectangle x:Name="DimBottom" Fill="#99000000" />
            <Rectangle x:Name="DimLeft" Fill="#99000000" />
            <Rectangle x:Name="DimRight" Fill="#99000000" />
            <Rectangle
                x:Name="SelectionHalo"
                Fill="Transparent"
                Stroke="#66FFFFFF"
                StrokeThickness="5"
                Visibility="Collapsed" />
            <Rectangle
                x:Name="SelectionBorder"
                Fill="Transparent"
                Stroke="#FF3B9EFF"
                StrokeThickness="2"
                Visibility="Collapsed" />
            <Line
                x:Name="CrosshairVShadow"
                Stroke="#99000000"
                StrokeThickness="3" />
            <Line
                x:Name="CrosshairHShadow"
                Stroke="#99000000"
                StrokeThickness="3" />
            <Line
                x:Name="CrosshairV"
                Stroke="#FF3B9EFF"
                StrokeThickness="1.25" />
            <Line
                x:Name="CrosshairH"
                Stroke="#FF3B9EFF"
                StrokeThickness="1.25" />
            <Border
                x:Name="SizeBadge"
                Padding="8,4"
                Background="#E6121212"
                BorderBrush="#FF3B9EFF"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="SizeText"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </Border>
        </Canvas>
    </Grid>
</Window>
